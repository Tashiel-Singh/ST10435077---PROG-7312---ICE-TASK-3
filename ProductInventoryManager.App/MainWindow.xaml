<Window x:Class="ProductInventoryManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Product Inventory Manager — C# Dictionary Application"
        Height="820" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Metric Card Title -->
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Metric Card Value -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <!-- Metric Card Subtitle -->
        <Style x:Key="MetricSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0EA5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Metric Cards -->
            <RowDefinition Height="Auto"/> <!-- Filters / Search Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Content Grid -->
            <RowDefinition Height="Auto"/> <!-- Toast / Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Product Inventory Manager" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#0369A1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PROG7312 ICE 3" FontSize="10" FontWeight="Bold" Foreground="#BAE6FD"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="C# Dictionary&lt;int, Product&gt; Data Structure Implementation"
                                   FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Architecture Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="Key: ProductID (int)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="Value: Product (Name, Price)" FontSize="11" Foreground="#34D399" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <TextBlock Text="Lookup: O(1) Hash Map" FontSize="11" Foreground="#A78BFA" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Header Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddProductButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#0284C7"
                            Foreground="#FFFFFF"
                            Click="AddProductButton_Click"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " FontSize="12"/>
                            <TextBlock Text="Add Product"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ResetSeedButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#1E293B"
                            Foreground="#94A3B8"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Click="ResetSeedButton_Click"
                            Margin="0,0,8,0"
                            ToolTip="Reset back to the 12 default assignment products">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="12"/>
                            <TextBlock Text="Reset Data"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenCliButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#312E81"
                            Foreground="#C7D2FE"
                            BorderBrush="#4338CA"
                            BorderThickness="1"
                            Click="OpenCliButton_Click"
                            ToolTip="Launch the interactive Console CLI for prompt-based interaction">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💻 " FontSize="12"/>
                            <TextBlock Text="Console CLI"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Metric KPI Cards Row -->
        <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Products -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TOTAL INVENTORY ITEMS" Style="{StaticResource MetricTitleStyle}"/>
                        <TextBlock x:Name="TotalProductsTextBlock" Text="12" Style="{StaticResource MetricValueStyle}" Foreground="#38BDF8"/>
                        <TextBlock Text="Distinct keys in Dictionary" Style="{StaticResource MetricSubtitleStyle}"/>
                    </StackPanel>
                    <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4"/>
                </Grid>
            </Border>

            <!-- Card 2: Total Valuation -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TOTAL INVENTORY VALUATION" Style="{StaticResource MetricTitleStyle}"/>
                        <TextBlock x:Name="TotalValueTextBlock" Text="R 0.00" Style="{StaticResource MetricValueStyle}" Foreground="#34D399"/>
                        <TextBlock x:Name="TotalUnitsTextBlock" Text="Total stock value (ZAR)" Style="{StaticResource MetricSubtitleStyle}"/>
                    </StackPanel>
                    <TextBlock Text="💰" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4"/>
                </Grid>
            </Border>

            <!-- Card 3: Average Unit Price -->
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="AVERAGE PRODUCT PRICE" Style="{StaticResource MetricTitleStyle}"/>
                        <TextBlock x:Name="AvgPriceTextBlock" Text="R 0.00" Style="{StaticResource MetricValueStyle}" Foreground="#FBBF24"/>
                        <TextBlock Text="Mean price across items" Style="{StaticResource MetricSubtitleStyle}"/>
                    </StackPanel>
                    <TextBlock Text="📊" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4"/>
                </Grid>
            </Border>

            <!-- Card 4: Top Valued Item -->
            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="HIGHEST PRICED ITEM" Style="{StaticResource MetricTitleStyle}"/>
                        <TextBlock x:Name="TopProductTextBlock" Text="JBL Speaker" Style="{StaticResource MetricValueStyle}" FontSize="18" Foreground="#F43F5E"/>
                        <TextBlock x:Name="TopProductPriceTextBlock" Text="R 8,000.00 (ID: 102)" Style="{StaticResource MetricSubtitleStyle}"/>
                    </StackPanel>
                    <TextBlock Text="⭐" FontSize="26" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.4"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Search and Filter Toolbar -->
        <Border Grid.Row="2" Background="#131D31" BorderBrush="#1E293B" BorderThickness="0,1,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Height="36"
                             TextChanged="SearchTextBox_TextChanged"/>
                    <TextBlock Text="🔍 Search ID, Name, or Category..."
                               IsHitTestVisible="False"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Category Filter -->
                <ComboBox x:Name="CategoryFilterComboBox"
                          Grid.Column="2"
                          Style="{StaticResource ModernComboBoxStyle}"
                          SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>

                <!-- Sort Order -->
                <ComboBox x:Name="SortComboBox"
                          Grid.Column="4"
                          Style="{StaticResource ModernComboBoxStyle}"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="Product ID (Ascending)" IsSelected="True"/>
                    <ComboBoxItem Content="Product ID (Descending)"/>
                    <ComboBoxItem Content="Price (Low to High)"/>
                    <ComboBoxItem Content="Price (High to Low)"/>
                    <ComboBoxItem Content="Product Name (A-Z)"/>
                </ComboBox>

                <!-- Clear Filters Button -->
                <Button x:Name="ClearFiltersButton"
                        Grid.Column="6"
                        Content="Reset Filters"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#1E293B"
                        Foreground="#94A3B8"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Click="ClearFiltersButton_Click"/>

                <!-- Showing Records Text -->
                <TextBlock x:Name="ResultCountTextBlock"
                           Grid.Column="8"
                           Text="Showing 12 of 12 products"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Data Table & Product Inspector Drawer -->
        <Grid Grid.Row="3" Margin="24,14,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Product DataGrid -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <DataGrid x:Name="ProductsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          Foreground="#F8FAFC"
                          BorderThickness="0"
                          RowHeight="44"
                          ColumnHeaderHeight="38"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="ProductsDataGrid_SelectionChanged">

                    <!-- DataGrid Styling -->
                    <DataGrid.Resources>
                        <!-- Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <!-- Row Style -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#293548"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0369A1"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Product ID Pill -->
                        <DataGridTemplateColumn Header="ID" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding FormattedId}"
                                                   FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name -->
                        <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>

                        <!-- Category -->
                        <DataGridTemplateColumn Header="CATEGORY" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#131D31" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}" Foreground="#94A3B8" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Price -->
                        <DataGridTemplateColumn Header="PRICE" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedPrice}" FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock -->
                        <DataGridTemplateColumn Header="STOCK" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedStock}" Foreground="#CBD5E1" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Inline -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✏️"
                                                Width="28" Height="28"
                                                Margin="0,0,6,0"
                                                Background="#0F172A"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip="Edit Product"
                                                Click="RowEditButton_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="🗑️"
                                                Width="28" Height="28"
                                                Background="#0F172A"
                                                BorderBrush="#4C0519"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip="Delete Product"
                                                Click="RowDeleteButton_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Product Inspector Sidebar -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                <Grid>
                    <!-- If No Product Selected -->
                    <StackPanel x:Name="NoSelectionPlaceholder"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,10"/>
                        <TextBlock Text="No Product Selected" FontSize="16" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a product from the dictionary table to inspect details and O(1) key characteristics."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Selected Product Details -->
                    <Grid x:Name="SelectedDetailsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Product ID & Category Banner -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Border Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock x:Name="DetailIdTextBlock" Text="#101"
                                           FontWeight="Bold" Foreground="#38BDF8" FontSize="13"/>
                            </Border>

                            <Border Background="#131D31" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                                <TextBlock x:Name="DetailCategoryTextBlock" Text="Computers"
                                           Foreground="#A5B4FC" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- Name & Price -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock x:Name="DetailNameTextBlock" Text="Laptop"
                                       FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailPriceTextBlock" Text="R 5,000.00"
                                       FontSize="24" FontWeight="ExtraBold" Foreground="#34D399" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DetailStockTextBlock" Text="15 unit(s) available in inventory"
                                       FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Description & Dictionary Diagnostics -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="PRODUCT DESCRIPTION" Style="{StaticResource MetricTitleStyle}"/>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,4,0,16">
                                    <TextBlock x:Name="DetailDescriptionTextBlock"
                                               Text="High-performance portable workstation with 16GB RAM."
                                               FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Technical Dictionary Specs -->
                                <TextBlock Text="DICTIONARY DATA STRUCTURE DIAGNOSTICS" Style="{StaticResource MetricTitleStyle}"/>
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Dictionary Key:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock x:Name="DiagKeyTextBlock" Text="101 (int)" HorizontalAlignment="Right"
                                                       FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Hash Code:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock x:Name="DiagHashTextBlock" Text="101" HorizontalAlignment="Right"
                                                       FontSize="11" Foreground="#94A3B8"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Lookup Complexity:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="O(1) Constant" HorizontalAlignment="Right"
                                                       FontSize="11" Foreground="#34D399" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Storage Type:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="Dictionary&lt;int, Product&gt;" HorizontalAlignment="Right"
                                                       FontSize="11" Foreground="#A78BFA"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Quick Actions -->
                        <Grid Grid.Row="4" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="DetailEditButton"
                                    Grid.Column="0"
                                    Content="✏️ Edit Details"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#0284C7"
                                    Foreground="#FFFFFF"
                                    Click="DetailEditButton_Click"/>

                            <Button x:Name="DetailDeleteButton"
                                    Grid.Column="2"
                                    Content="🗑️ Delete Item"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#E11D48"
                                    Foreground="#FFFFFF"
                                    Click="DetailDeleteButton_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Toast Notification Status Bar -->
        <Border Grid.Row="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

