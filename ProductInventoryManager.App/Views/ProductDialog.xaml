<Window x:Class="ProductInventoryManager.App.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Product Details"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0EA5E9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="BorderBrush" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="DialogTitleTextBlock"
                           Text="Add New Product"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#38BDF8"/>
                <TextBlock x:Name="DialogSubtitleTextBlock"
                           Text="Enter the product details to store in the Dictionary&lt;int, Product&gt;."
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Separator Grid.Row="1" Background="#334155" Margin="0,0,0,12"/>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Product ID -->
                    <TextBlock Text="PRODUCT ID (UNIQUE DICTIONARY KEY)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ProductIdTextBox" ToolTip="Unique positive integer key for dictionary"/>

                    <!-- Product Name -->
                    <TextBlock Text="PRODUCT NAME *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ProductNameTextBox" ToolTip="Name of the product (e.g., Wireless Mouse)"/>

                    <!-- Price -->
                    <TextBlock Text="PRICE IN SOUTH AFRICAN RAND (R) *" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#334155" CornerRadius="6,0,0,6">
                            <TextBlock Text="R" Foreground="#38BDF8" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBox x:Name="ProductPriceTextBox" Grid.Column="1"
                                 BorderThickness="1,1,1,1" Margin="-1,0,0,0"
                                 ToolTip="Numeric price (e.g., 5000.00)"/>
                    </Grid>

                    <!-- Category & Stock Row -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORY" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ProductCategoryTextBox" ToolTip="e.g., Computers, Audio, Mobile"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STOCK QUANTITY" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ProductStockTextBox" Text="1" ToolTip="Positive integer"/>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="DESCRIPTION (OPTIONAL)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ProductDescriptionTextBox" Height="70"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Optional product description"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Error Message -->
            <TextBlock x:Name="ErrorMessageTextBlock"
                       Grid.Row="3"
                       Foreground="#F43F5E"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,8,0,8"
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100" Height="36"
                        Margin="0,0,12,0"
                        Background="#1E293B"
                        Foreground="#94A3B8"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="SaveButton"
                        Content="Save Product"
                        Width="130" Height="36"
                        Background="#0284C7"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SaveButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
