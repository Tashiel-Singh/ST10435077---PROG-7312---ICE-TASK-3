<Window x:Class="ProductInventoryManager.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Deletion"
        Height="240" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Background="#F43F5E" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0">
                    <TextBlock Text="🗑️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Confirm Deletion" FontSize="18" FontWeight="Bold" Foreground="#F43F5E"/>
                    <TextBlock Text="This action cannot be undone." FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="MessageTextBlock"
                       Grid.Row="1"
                       Text="Are you sure you want to remove this product from the Dictionary?"
                       FontSize="13"
                       Foreground="#CBD5E1"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel"
                        Width="90" Height="34"
                        Margin="0,0,10,0"
                        Background="#1E293B"
                        Foreground="#94A3B8"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Delete"
                        Width="100" Height="34"
                        Background="#E11D48"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ConfirmButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
